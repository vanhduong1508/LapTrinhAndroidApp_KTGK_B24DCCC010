<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/stroke_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Row 1: Top Line - Book ID on left, Status Badge on top-right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBookId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mã sách: S001"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBookStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_available"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Có sẵn"
                android:textColor="@color/status_available_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Book Title -->
        <TextView
            android:id="@+id/tvBookTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Lập trình Android cơ bản"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Row 3: Author below Title -->
        <TextView
            android:id="@+id/tvBookAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tác giả: Nguyễn Văn A"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Row 4: Category Tag -->
        <TextView
            android:id="@+id/tvBookCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_category"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Công nghệ thông tin"
            android:textColor="@color/chip_category_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Light Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@color/stroke_light" />

        <!-- Row 5: Action Buttons (Right-aligned) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditBook"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="Sửa"
                android:textColor="@color/btn_edit_text"
                android:textSize="12sp"
                app:backgroundTint="@color/btn_edit_bg"
                app:cornerRadius="17dp"
                app:icon="@drawable/ic_edit"
                app:iconPadding="4dp"
                app:iconSize="14dp"
                app:iconTint="@color/btn_edit_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteBook"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="Xóa"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="@color/btn_delete_bg"
                app:cornerRadius="17dp"
                app:icon="@drawable/ic_delete"
                app:iconPadding="4dp"
                app:iconSize="14dp"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>